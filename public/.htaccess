# ==============================================================================
# Schlüsselnotdienst Rhein-Selz - Apache Server Configuration
# Clean URLs (no .html), 301 Redirects, Security & Cache Headers
# ==============================================================================

RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------------
# 1. Hide Server Signature & Disable Directory Browsing
# ------------------------------------------------------------------------------
ServerSignature Off
Options -Indexes

# ------------------------------------------------------------------------------
# 2. Block Access to Hidden / Sensitive System Files
# ------------------------------------------------------------------------------
RewriteRule ^\..* - [F,L]
<FilesMatch "(^\.|package\.json|package-lock\.json|vite\.config\.js)">
    Order allow,deny
    Deny from all
</FilesMatch>

# ------------------------------------------------------------------------------
# 3. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 4. Redirect index.html to Root Domain (/)
# ------------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ------------------------------------------------------------------------------
# 5. Redirect Old English URLs to New German Clean URLs
# ------------------------------------------------------------------------------
RewriteRule ^about(\.html)?$ /ueber-uns [R=301,L]
RewriteRule ^services(\.html)?$ /leistungen [R=301,L]
RewriteRule ^pricing(\.html)?$ /preise [R=301,L]
RewriteRule ^contact(\.html)?$ /kontakt [R=301,L]

# ------------------------------------------------------------------------------
# 6. Strip .html from Browser Address Bar (301 Permanent Redirect)
# If a visitor accesses a .html file directly, redirect to the clean URL
# ------------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ------------------------------------------------------------------------------
# 7. Internally Rewrite Clean URLs to .html Files
# e.g. /leistungen -> leistungen.html (URL in browser stays /leistungen)
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]
